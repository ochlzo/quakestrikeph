<script>
  document.addEventListener('astro:before-swap', (event) => {
    if (event.from.pathname === event.to.pathname || matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const navigation = event.newDocument.querySelector('.bulletin-header .site-nav');
    const previousTab = Array.from(navigation?.querySelectorAll<HTMLAnchorElement>('[role="tab"]') ?? [])
      .find((tab) => tab.getAttribute('href') === event.from.pathname);
    const selectedTab = navigation?.querySelector<HTMLElement>('[data-selected]');
    const indicator = selectedTab?.querySelector<HTMLElement>('.bulletin-nav-indicator');
    if (!previousTab || !selectedTab || !indicator) return;

    void event.viewTransition.ready.then(() => {
      if (event.signal.aborted || !indicator.isConnected || !indicator.offsetWidth) return;

      // Measure both positions in the new header. The results sidebar changes the header's center.
      const previous = previousTab.getBoundingClientRect();
      const selected = selectedTab.getBoundingClientRect();
      const distance = previous.left + previous.width / 2 - selected.left - selected.width / 2;
      if (!distance) return;
      const startScale = previous.width / selected.width;
      const stretchScale = (startScale * 0.3 + 0.7) * 1.1;
      const timing = { duration: 320, easing: 'cubic-bezier(.16, 1, .3, 1)' };
      indicator.animate({ translate: [`${distance}px`, '0px'] }, timing);
      indicator.animate([
        { scale: `${startScale} 1` },
        { scale: `${stretchScale} 1`, offset: 0.3 },
        { scale: '1 1' },
      ], timing);
    }, () => { /* A skipped page transition leaves the selected tab in place. */ });
  });
</script>
