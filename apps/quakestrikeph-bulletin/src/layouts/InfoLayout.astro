---
import '../styles/bulletin.css';
import { Activity, Bell } from 'lucide-react';
const { title, active } = Astro.props as { title: string; active: 'forecasts' | 'about' | 'alerts' };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · QuakeStrike PH Bulletin</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="QuakeStrike PH Bulletin home"><span class="brand-mark"><Activity size={24} strokeWidth={2.2} aria-hidden="true" /></span><span><strong>QuakeStrike PH Bulletin</strong><small>PHILIPPINE EARTHQUAKE INFORMATION</small></span></a>
      <nav class="site-nav" aria-label="Main navigation"><a href="/">Earthquakes</a><a href="/forecasts" aria-current={active === 'forecasts' ? 'page' : undefined}>Forecasts</a><a href="/about" aria-current={active === 'about' ? 'page' : undefined}>About</a></nav>
      <a class="alerts-button" href="/alerts" aria-current={active === 'alerts' ? 'page' : undefined}><Bell size={17} aria-hidden="true" />Receive alerts</a>
    </header>
    <main class="info-main"><slot /></main>
  </body>
</html>
