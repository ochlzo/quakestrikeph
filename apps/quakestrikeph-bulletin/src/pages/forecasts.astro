---
import InfoLayout from '../layouts/InfoLayout.astro';
---
<InfoLayout title="Forecasts" active="forecasts">
  <a class="back-link" href="/">← Earthquakes</a>
  <div class="info-intro"><h1>Earthquake forecasts</h1><p>Forecasts describe the probability of earthquake activity in a time window. They are not exact predictions of when or where an earthquake will happen.</p></div>
  <section class="info-card" aria-labelledby="event-heading"><span class="info-card-label">Selected earthquake</span><h2 id="event-heading">Choose an earthquake from the Bulletin</h2><p id="event-status">Open an event on the map or in the list, then select “View forecast.”</p><div id="event-facts" hidden></div></section>
  <section class="info-card" aria-labelledby="forecast-heading"><span class="info-card-label">Forecast status</span><h2 id="forecast-heading">Probability details are not published yet</h2><p>The geographic area for these model outputs still needs to be confirmed. Once that is defined and validated, this page can show a probability and its exact time window for the selected event.</p><p id="forecast-window" hidden></p></section>
  <p class="info-caution">For safety decisions, follow <a href="https://www.phivolcs.dost.gov.ph/" target="_blank" rel="noopener noreferrer">official PHIVOLCS guidance</a> and instructions from local authorities.</p>
</InfoLayout>

<script>
  import { demoEvents, displayTime, magnitude, type Earthquake } from '../lib/events';
  const params = new URLSearchParams(window.location.search);
  const eventId = params.get('event');
  const heading = document.querySelector<HTMLHeadingElement>('#event-heading')!;
  const status = document.querySelector<HTMLParagraphElement>('#event-status')!;
  const facts = document.querySelector<HTMLDivElement>('#event-facts')!;
  const windowLine = document.querySelector<HTMLParagraphElement>('#forecast-window')!;

  function show(item: Earthquake & { forecast?: { windowStart: string; windowEnd: string } | null }) {
    heading.textContent = `${magnitude(item.magnitude)} · ${item.locationDescription}`;
    status.textContent = displayTime(item.eventTime);
    facts.textContent = `Depth: ${item.depthKm === null ? 'Unknown' : `${item.depthKm} km`} · Source: PHIVOLCS`;
    facts.hidden = false;
    if (item.forecast) {
      windowLine.textContent = `Forecast window: ${displayTime(item.forecast.windowStart)} to ${displayTime(item.forecast.windowEnd)}.`;
      windowLine.hidden = false;
    }
  }

  if (eventId) {
    if (import.meta.env.DEV && params.has('demo')) {
      const item = demoEvents.find((event) => event.eventId === eventId);
      if (item) show(item);
    } else {
      status.textContent = 'Loading selected earthquake…';
      fetch(`/api/v1/earthquakes/${encodeURIComponent(eventId)}`)
        .then((response) => response.ok ? response.json() : Promise.reject(new Error('event unavailable')))
        .then((data: { item: Earthquake & { forecast?: { windowStart: string; windowEnd: string } | null } }) => show(data.item))
        .catch(() => { status.textContent = 'This earthquake is unavailable right now. Return to the Bulletin to choose another event.'; });
    }
  }
</script>
