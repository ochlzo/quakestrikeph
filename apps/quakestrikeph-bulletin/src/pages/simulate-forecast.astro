---
import BackgroundToaster from '@/components/BackgroundToaster';
import Simulation from '@/features/forecast-simulation/Simulation';
import { loadSimulationPage } from '@/lib/api/forecast-simulations.server';
import '@/styles/globals.css';
import '@/styles/forecast.css';
import '@/styles/simulate.css';

const confirm = Astro.url.searchParams.get('confirm') === '1';
const { guestCookieConfirmed, catalog, setCookie } = await loadSimulationPage(Astro.request.headers.get('Cookie'), confirm);
if (!confirm && guestCookieConfirmed === false && setCookie) {
  return new Response(null, {
    status: 302,
    headers: { Location: '/simulate-forecast?confirm=1', 'Set-Cookie': setCookie, 'Cache-Control': 'no-store' },
  });
}
Astro.response.headers.set('Cache-Control', 'no-store');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Simulate Forecast · QuakeStrike PH Bulletin</title>
  </head>
  <body class="forecast-page simulate-page">
    <a class="skip" href="#simulator">Skip to simulation</a>
    <main class="shell" id="simulator" tabindex="-1"
      data-catalog-status={catalog.status}
      data-catalog-cutoff={catalog.catalogCutoff}
      data-guest-cookie-confirmed={guestCookieConfirmed?.toString()}>
      <h1>Simulate Forecast</h1>
      <Simulation client:load catalog={catalog} guestCookieConfirmed={guestCookieConfirmed} />
    </main>
    <BackgroundToaster client:load />
    <script>
      const url = new URL(window.location.href);
      if (url.searchParams.get('confirm') === '1') {
        // A later reload must be able to issue a cookie again.
        url.searchParams.delete('confirm');
        window.history.replaceState(window.history.state, '', url);
      }
    </script>
  </body>
</html>
