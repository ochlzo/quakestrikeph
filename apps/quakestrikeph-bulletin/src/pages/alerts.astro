---
import InfoLayout from '../layouts/InfoLayout.astro';
---
<InfoLayout title="Receive alerts" active="alerts">
  <a class="back-link" href="/">← Earthquakes</a>
  <div class="info-intro"><h1>Receive alerts</h1><p>Choose whether you want earthquake alerts, then set your preferences when account setup is available.</p></div>
  <section class="info-card"><h2>Alert setup is coming</h2><p>Sign in and alert preferences are not available in the Bulletin yet. You can browse earthquake information without an account.</p><a class="info-primary-link" href="/">View recent earthquakes →</a></section>
</InfoLayout>
