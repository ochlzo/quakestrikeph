---
import Bulletin from '../components/Bulletin';
import '../styles/globals.css';
import type { components } from '../lib/api/schema';
import { getSecret } from 'astro:env/server';

let initialResults: components['schemas']['SearchResponse'] | null = null;
try {
  const response = await fetch(new URL('/api/v1/earthquakes/search', getSecret('API_TARGET') || 'https://quakestrikeph.qzz.io'), {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ limit: 30 }),
    signal: AbortSignal.timeout(1500),
  });
  if (response.ok) {
    const data: components['schemas']['SearchResponse'] = await response.json();
    initialResults = { ...data, items: data.items.slice(0, 30) };
  }
} catch {
  // The browser can restore saved rows and retry if the initial request fails.
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>QuakeStrike PH Bulletin</title>
    <meta name="description" content="Explore recent earthquakes in the Philippines and understand earthquake forecast information." />
    <link rel="preconnect" href="https://tiles.openfreemap.org" crossorigin="anonymous" />
    <link rel="preload" as="fetch" href="https://tiles.openfreemap.org/styles/liberty" crossorigin="anonymous" />
    <link rel="preload" as="fetch" href="https://tiles.openfreemap.org/planet" crossorigin="anonymous" />
    <link rel="preload" as="image" href="/assets/plates/relief-map.webp" />
    <script>
      import { loadMapRuntime } from "../lib/map-runtime";
      void loadMapRuntime().catch(() => { /* MapPanel retries and retains its placeholder on failure. */ });
    </script>
  </head>
  <body>
    <Bulletin initialResults={initialResults} client:load />
  </body>
</html>
