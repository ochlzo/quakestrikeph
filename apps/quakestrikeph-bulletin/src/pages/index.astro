---
import Bulletin from '../components/Bulletin';
import { ClientRouter } from 'astro:transitions';
import BackgroundToaster from '../components/BackgroundToaster';
import AccountModalNavigation from '../components/AccountModalNavigation.astro';
import '../styles/globals.css';
import { readBulletinState } from '../lib/bulletin-navigation';
import { prepareEventResults } from '../features/event-results/server';
import { searchInitialEvents } from '../lib/api/event-results.server';

const earthquakeId = Astro.url.searchParams.get('earthquake');
const initialState = readBulletinState(Astro.url.searchParams);
if (earthquakeId !== null) {
  if (!earthquakeId) return Astro.redirect('/');
  return Astro.redirect(`/forecasts/${encodeURIComponent(earthquakeId)}`);
}
const initialResults = await prepareEventResults(initialState, searchInitialEvents);
---
<!doctype html>
<html lang="en">
  <head>
    <ClientRouter />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>QuakeStrike PH Bulletin</title>
    <meta name="description" content="Explore recent earthquakes in the Philippines and understand earthquake forecast information." />
    <link rel="preconnect" href="https://tiles.openfreemap.org" crossorigin="anonymous" />
    <link rel="preload" as="fetch" href="https://tiles.openfreemap.org/styles/liberty" crossorigin="anonymous" />
    <link rel="preload" as="fetch" href="https://tiles.openfreemap.org/planet" crossorigin="anonymous" />
    <link rel="preload" as="image" href="/assets/plates/relief-map.webp" />
    <script>
      import { loadMapRuntime } from "../lib/map-runtime";
      void loadMapRuntime().catch(() => { /* MapPanel retries and retains its placeholder on failure. */ });
    </script>
  </head>
  <body>
    <div id="bulletin-view">
      <Bulletin initialResults={initialResults} initialState={initialState} client:load />
    </div>
    <AccountModalNavigation />
    <BackgroundToaster client:only="react" transition:persist="account-notifications" />
  </body>
</html>
