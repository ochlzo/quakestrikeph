# Copy this file to .env for local development. Values here are placeholders.
# The Compose stack uses private container networking and does not publish data
# service ports to the host.

DATABASE_URL=postgresql+psycopg://quakestrike_worker:replace-worker-password@postgres:5432/quakestrike
MIGRATION_DATABASE_URL=postgresql+psycopg://quakestrike_migration:replace-migration-password@postgres:5432/quakestrike
WORKER_IMAGE_TAG=
REDIS_URL=redis://redis:6379/0
PHIVOLCS_CATALOG_URL=https://example.invalid/phivolcs/catalog
MODEL_RELEASE_ID=a7f2286b-13a2-4708-a04d-4139281a4e1f
PUBLIC_BULLETIN_BASE_URL=https://quakestrikeph.qzz.io
MODEL_ARTIFACT_DIRECTORY=model-artifacts
MODEL_ARTIFACT_HOST_DIRECTORY=../model-artifacts
BOOTSTRAP_RUN_MANIFEST=database/initialization/bootstrap-readiness.json
BOOTSTRAP_REQUIRED_AVAILABLE_THROUGH=2026-09-01T00:00:00+08:00

POLL_INTERVAL_SECONDS=300
DISPATCHER_POLL_INTERVAL_SECONDS=5
DISPATCHER_BATCH_SIZE=10
DISPATCH_LEASE_SECONDS=60
INGESTOR_LEASE_SECONDS=900
INGESTOR_CONCURRENCY=1
PREDICTION_SOFT_TIME_LIMIT_SECONDS=300
PREDICTION_HARD_TIME_LIMIT_SECONDS=360
DETAIL_REQUEST_DELAY_SECONDS=0.1
DETAIL_REQUEST_CONCURRENCY=4
RETRY_DELAYS_SECONDS=[30,120,600]
MAX_RESPONSE_BYTES=20000000
HTTP_CONNECT_TIMEOUT_SECONDS=10
HTTP_READ_TIMEOUT_SECONDS=30

LOG_LEVEL=INFO

# Optional private testing. Normal deployment never starts these services.
# All three readers use the same explicit test Redis; never use the production broker.
ALERT_TEST_IMAGE_TAG=
ALERT_TEST_REDIS_URL=
ALERT_TEST_DATABASE_URL=
ALERT_TEST_ORIGIN=https://quakestrike-vps.tailf8b2fd.ts.net:8443
ALERT_TEST_PUBLIC_BULLETIN_URL=https://quakestrikeph.qzz.io
ALERT_TEST_PREPARATION_KEY=
ALERT_TEST_CONSUMER_ENABLED=false
ALERT_TEST_IPROG_TOKEN=
ALERT_TEST_BREVO_API_KEY=
ALERT_TEST_BREVO_SENDER_EMAIL=
ALERT_TEST_BREVO_SENDER_NAME=

# Compose-only local values. Replace POSTGRES_PASSWORD outside source control.
POSTGRES_DB=quakestrike
POSTGRES_USER=quakestrike
POSTGRES_PASSWORD=replace-me
MIGRATION_DB_PASSWORD=replace-migration-password
WORKER_DB_PASSWORD=replace-worker-password
BACKEND_DB_PASSWORD=replace-backend-password
BACKEND_DATABASE_URL=postgresql://quakestrike_backend:replace-backend-password@postgres:5432/quakestrike
BACKEND_IMAGE_TAG=replace-with-tested-git-sha
BULLETIN_IMAGE_TAG=replace-with-tested-git-sha
# Cloudflare remotely managed tunnel token; configure quakestrikeph.qzz.io to http://traefik:80.
CLOUDFLARE_TUNNEL_TOKEN=replace-cloudflare-tunnel-token
OBSERVER_DB_PASSWORD=replace-observer-password

# Optional private pgAdmin UI. Use separate credentials and keep .env off Git.
PGADMIN_DEFAULT_EMAIL=operator@example.com
PGADMIN_DEFAULT_PASSWORD=replace-pgadmin-password

# Bulletin account settings (Backend only; never pass secrets to Bulletin).
# Alert publication and submission require separate explicit gates. Both default disabled.
ALERT_RESOLUTION_ENABLED=false
ALERT_DELIVERY_ENABLED=false
ALERT_RECONCILIATION_INTERVAL_SECONDS=5
ALERT_RECONCILIATION_BATCH_SIZE=20
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:4321,http://127.0.0.1:4321
ACCOUNT_REDIS_URL=redis://redis:6379/0
# Server-only IPROG credential for Backend verification and worker delivery/reconciliation.
IPROG_API_TOKEN=
# Server-only Brevo submission and separate Backend callback authentication.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=alerts@quakestrikeph.qzz.io
BREVO_SENDER_NAME=QuakeStrike PH - Alert System
BREVO_CALLBACK_TOKEN=
# Private authorization for a selected disposable fixture; never copy production accounts.
# Keep exact designated contacts in ignored private configuration only.
ALERT_TEST_SMS_DESTINATION=
ALERT_TEST_EMAIL_DESTINATION=
# Frontend build uses only this public key.
PUBLIC_CLERK_PUBLISHABLE_KEY=
