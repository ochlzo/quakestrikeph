# Additional CLI tools for the complete unit suite. Never used by production services.
ARG BASE_IMAGE=quakestrike-data-ingestion-test-prediction-smoke-runner:latest
FROM docker:29.5.2-cli AS docker-cli
FROM ${BASE_IMAGE}
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
RUN apt-get update \
    && apt-get install --no-install-recommends -y curl git \
    && curl --fail --location --retry 3 \
       https://github.com/PowerShell/PowerShell/releases/download/v7.5.11/powershell_7.5.11-1.deb_amd64.deb \
       -o /tmp/powershell.deb \
    && apt-get install --no-install-recommends -y /tmp/powershell.deb \
    && rm -f /tmp/powershell.deb \
    && rm -rf /var/lib/apt/lists/*
COPY .gitignore /workspace/.gitignore
RUN git init /workspace
